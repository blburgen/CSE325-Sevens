# Build stage: use the full SDK to compile and publish
FROM mcr.microsoft.com/dotnet/sdk:11.0 AS build
WORKDIR /src
COPY . .
RUN dotnet restore CSE325-Sevens.csproj
RUN dotnet publish CSE325-Sevens.csproj -c Release -o /app/publish

# Runtime stage: smaller image with just the ASP.NET runtime
FROM mcr.microsoft.com/dotnet/aspnet:11.0 AS final
WORKDIR /app
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "CSE325-Sevens.dll"]